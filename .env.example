# Safe local demo defaults, never real production secrets.
DATABASE_URL=postgresql://scout:scout_local_only@db:5432/scout
POSTGRES_PASSWORD=scout_local_only
MODE=off
TELEGRAM_TOKEN=
ALLOWED_CHAT_IDS=
WEBHOOK_URL=
WEBHOOK_SECRET=
# polling and webhook are exclusive values of MODE. off needs no Telegram credentials.
# For a host Python process change DB hostname to localhost.
